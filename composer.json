{
    "name": "sos-events-bv/cms",
    "description": "CMS Panel plugin for websites of SOS Events BV.",
    "keywords": [
        "SOS-Events-BV",
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "cms"
    ],
    "homepage": "https://github.com/sos-events-bv/cms",
    "support": {
        "issues": "https://github.com/sos-events-bv/cms/issues",
        "source": "https://github.com/sos-events-bv/cms"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Steven Erik Martijn Roest",
            "email": "steven@sosevents.nl",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "bezhansalleh/filament-language-switch": "^5.1",
        "cocosmos/filament-sticky-save-bar": "^1.1",
        "dutchcodingcompany/filament-socialite": "^3.3",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^v5.6.0",
        "filament/spatie-laravel-settings-plugin": "^v5.6.0",
        "pboivin/filament-peek": "^v4.1.2",
        "socialiteproviders/microsoft": "^4.10",
        "spatie/laravel-honeypot": "^4.7.1",
        "spatie/laravel-medialibrary": "^11.21.0",
        "spatie/laravel-package-tools": "^1.15.0",
        "spatie/laravel-settings": "^3.7.2",
        "spatie/schema-org": "^4.0.2"
    },
    "autoload": {
        "psr-4": {
            "SOSEventsBV\\Cms\\": "src/",
            "SOSEventsBV\\Cms\\Database\\Factories\\": "database/factories/"
        }
    },
    "scripts": {
        "lint": "pint",
        "test:lint": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "SOSEventsBV\\Cms\\CmsServiceProvider"
            ],
            "aliases": {
                "Cms": "SOSEventsBV\\Cms\\Facades\\Cms"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
